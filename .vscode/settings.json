{
  "arduino.tools": "${userHome}/AppData/Local/Arduino15/packages/arduino/tools",
  "arduino.boardtype": "${userHome}/AppData/Local/Arduino15/packages/arduino/hardware/mbed_nano/4.4.1",
  "arduino.libraries": "${userHome}/Documents/Arduino/libraries",
  "arduino.useArduinoCli": true,
  "arduino.logLevel": "info",
  "arduino.path": "C:/Program Files/Arduino CLI",
  "yaml.schemas": {
    "https://squidfunk.github.io/mkdocs-material/schema.json": "mkdocs.yml"
  },
  "yaml.customTags": [ 
    "!ENV scalar",
    "!ENV sequence",
    "!relative scalar",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.to_svg",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.twemoji",
    "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format",
    "tag:yaml.org,2002:python/object/apply:pymdownx.slugs.slugify mapping"
  ],
  "editor.rulers": [
      100
  ],
  "editor.autoIndentOnPaste": true,
  "yaml.format.printWidth": 100,
  "editor.minimap.maxColumn": 100,
  "docwriter.custom.author": "Alejandro Lara-Doña (alejandro.lara@uca.es)",
  "docwriter.progress.trackClasses": true,
  "docwriter.progress.trackTypes": true,
  "docwriter.style": "Doxygen",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 2, ColumnLimit: 100 }"
}